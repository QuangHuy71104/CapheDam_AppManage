{
  "expo": {
    "name": "Cà phê Đạm",
    "slug": "caphedam-appmanage",
    "scheme": "caphedam",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EDE1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.caphedam.appmanage"
    },
    "android": {
      "package": "com.caphedam.appmanage",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5EDE1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    }
  }
}
