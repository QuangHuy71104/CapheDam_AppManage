{
  "name": "caphedam_appmanage",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "dev:vercel": "npx vercel dev",
    "web": "vite --host 127.0.0.1",
    "web:lan": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:web": "npm run build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/architecture.test.mjs",
    "test:business": "vitest run --config vitest.config.ts tests/business",
    "test:ui": "vitest run --config vitest.config.ts tests/ui",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:all": "npm test && npm run test:unit",
    "check": "npm run lint && npm run typecheck && npm run test:all && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "supabase": "^2.113.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "private": true
}
